# short-description: Create Raspberry Pi SD card image with two rootfs partitions and a data partition
# long-description: Creates a partitioned SD card image for use with
# Raspberry Pi. Boot files are located in the first vfat partition.

part /boot --source bootimg-partition --ondisk mmcblk0 --fstype=vfat --label boot --active --align 4096 --size 100
part / --source rootfs --ondisk mmcblk0 --fstype=ext4 --label rootfs_A --size 1G --align 4096
part / --source rootfs --ondisk mmcblk0 --fstype=ext4 --label rootfs_B --size=1G --align 4096
part /data --ondisk mmcblk0 --fstype=ext4 --label data --size=1G --align 4096
